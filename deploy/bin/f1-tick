#!/usr/bin/env bash
# f1-tick (f1-tick.timer, every 10 min; A§14.5, D9).
# 1. Reloads the f1 firewall when table inet f1 is missing (first, so no later step can skip it):
#    stopping f1-firewall keeps the table, but a `nft delete table inet f1` by hand, or Debian's
#    nftables.service flushing the ruleset, removes it while the containers keep running. When
#    the reload fails, it stops every f1 container (fail closed) until a tick or f1-update finds
#    the table loaded again and starts current.env (resume_stack).
# 2. Refreshes the DNS allowlist (f1-resolvers).
# 3. Under f1-update's lock (skipped this round while a deploy or f1-install holds it): starts the
#    stack that step 1 stopped, once the table is back, and restarts every f1 container that
#    Docker reports unhealthy: Docker itself restarts only a container that exited.
#    /srv/f1/state/restarts keeps "<name> <rounds>" for the containers this step restarted in its
#    last round, so a container restarted in 3 rounds in a row alerts "restart_loop <name>".
# 4. The recorder watch (#104): /etc/f1/recorder-watch.sql in a read-only transaction in f1-db-1
#    alerts "recorder_missing", "recorder_stale" or "login_failed" with the session key, once per
#    session until the condition ends. It fails open: no database, no recorder alert this round.
# 5. Writes "<UTC time> <free bytes of /srv/f1> <free bytes of the Docker data root>" to
#    /srv/f1/state/disk; under 20 GiB on either alerts "disk_low", once until both are above again.
# The alerts go to f1-ingest/fail through alert_once (f1-lib.sh), each only once per condition;
# /srv/f1/state/alert-<code> holds what alerted last. A failed run (exit 1) fails f1-tick.service,
# whose OnFailure= sends "unit_failed f1-tick.service".
# Exits 1 when the firewall could not be restored, the stack could not be started again, or the
# free disk space could not be read.
#
# Usage: f1-tick
set -euo pipefail
# shellcheck source=deploy/bin/f1-lib.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/f1-lib.sh"

if (($#)); then
  echo "usage: f1-tick" >&2
  exit 64
fi
rc=0 fw=1

if ! nft list table inet f1 >/dev/null 2>&1; then
  log "error: the f1 firewall (table inet f1) is missing: loading $F1_ETC/nftables-f1.conf"
  if ! nft -f "$F1_ETC/nftables-f1.conf"; then
    fw=0 rc=1
    # By label, not compose: also the containers of a failed first deploy, which has no current.env.
    mapfile -t running < <(docker ps -q --filter label=com.docker.compose.project=f1 2>/dev/null || true)
    if ((${#running[@]})); then
      : >"$F1_FW_STOPPED"
      docker stop "${running[@]}" >/dev/null || log "error: stopping the f1 containers failed"
    fi
    log "error: loading $F1_ETC/nftables-f1.conf failed: the f1 stack is stopped until the firewall loads"
  fi
fi

"$F1_BIN/f1-resolvers" --quiet || log "error: f1-resolvers failed"

exec 9>"$(lockfile update)"
if ! flock -n 9; then
  log "f1-update or f1-install is running: no container restarts this round"
else
  if ((fw)); then resume_stack || rc=1; fi
  mapfile -t sick < <(docker ps --filter label=com.docker.compose.project=f1 --filter health=unhealthy \
    --format '{{.Names}}' 2>/dev/null | sort || true)
  declare -A rounds=()
  if [[ -f $F1_STATE/restarts ]]; then
    while read -r name n; do
      if [[ $name =~ ^f1-[a-z0-9_.-]+$ && $n =~ ^[1-9][0-9]{0,5}$ ]]; then rounds[$name]=$n; fi
    done <"$F1_STATE/restarts"
  fi
  streaks='' looping=()
  for name in "${sick[@]}"; do
    [[ $name =~ ^f1-[a-z0-9_.-]+$ ]] || continue
    log "restarting unhealthy container $name"
    docker restart "$name" >/dev/null || log "error: restart of $name failed"
    n=$((${rounds[$name]:-0} + 1))
    streaks+="$name $n"$'\n'
    ((n < 3)) || looping+=("$name")
  done
  printf '%s' "$streaks" | write_atomic "$F1_STATE/restarts" 0600 ||
    log "warning: cannot write $F1_STATE/restarts"
  # ponytail: one alert per set of looping names, so a container joining or leaving the set alerts
  # again with the first name; keep state per name if that ever gets noisy.
  if ((${#looping[@]})); then
    alert_once restart_loop "${looping[*]}" "${looping[0]}"
  else
    alert_clear restart_loop
  fi
  exec 9>&-
fi

# Not under the lock: it only reads. Each line is "<code>|<session key>", from rows that containers
# write (f1_ingest), so root takes only the three codes and a numeric key, and nothing else from it.
if watch=$(timeout 20 docker exec -i f1-db-1 psql -X -q -tA -v ON_ERROR_STOP=1 -U postgres -d f1 -1 \
  -c 'SET TRANSACTION READ ONLY' -f - <"$F1_ETC/recorder-watch.sql" 2>/dev/null); then
  seen=' '
  while IFS='|' read -r code key; do
    [[ $code =~ ^(recorder_missing|recorder_stale|login_failed)$ && $key =~ ^[0-9]{1,10}$ ]] || continue
    seen+="$code "
    alert_once "$code" "$key" "$key"
  done <<<"$watch"
  for code in recorder_missing recorder_stale login_failed; do
    [[ $seen == *" $code "* ]] || alert_clear "$code"
  done
else
  log "warning: cannot run the recorder watch: no recorder alert this round"
fi

readonly DISK_LOW=$((20 * 1024 ** 3))
avail() { df -B1 --output=avail -- "$1" 2>/dev/null | tail -n 1 | tr -dc '0-9'; }
docker_root=$(docker info -f '{{.DockerRootDir}}' 2>/dev/null) || docker_root=''
free_f1=$(avail /srv/f1) || free_f1=''
free_docker=''
[[ $docker_root != /* ]] || free_docker=$(avail "$docker_root") || free_docker=''
if [[ $free_f1 =~ ^[0-9]{1,18}$ && $free_docker =~ ^[0-9]{1,18}$ ]]; then
  printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$free_f1" "$free_docker" | write_atomic "$F1_STATE/disk" 0600
  log "free disk: /srv/f1 $((10#$free_f1 / 1024 ** 3)) GiB, Docker data root $docker_root $((10#$free_docker / 1024 ** 3)) GiB"
  if ((10#$free_f1 < DISK_LOW || 10#$free_docker < DISK_LOW)); then
    alert_once disk_low low
  else
    alert_clear disk_low
  fi
else
  log "error: cannot read the free disk space of /srv/f1 and the Docker data root"
  rc=1
fi
exit "$rc"
