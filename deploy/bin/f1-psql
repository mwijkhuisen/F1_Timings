#!/usr/bin/env bash
# f1-psql (#106; A§14.5): psql in the f1 database of the running stack, for the runbooks' read-only
# diagnostics: sudo f1-psql -c 'SELECT …', or sudo f1-psql for a prompt. Through compose exec on db
# with current.env (compose needs its image references), as postgres over db's local socket: those
# diagnostics read lap_source and raw_response, which f1_api cannot read.
# Every transaction is read-only by default (default_transaction_read_only): a guard against an
# accident, not a boundary. A superuser can turn it off, and root owns the host anyway. Writes keep
# the runbooks' long `docker compose … exec db psql` form.
#
# Exit: psql's; 1 not root, or nothing deployed yet (no current.env).
#
# Usage: sudo f1-psql [<psql argument>…]
set -euo pipefail
# shellcheck source=deploy/bin/f1-lib.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/f1-lib.sh"

((EUID == 0)) || die "run as root (sudo)"
[[ -f $F1_STATE/current.env ]] || die "no $F1_STATE/current.env: nothing is deployed yet"
# A TTY for an interactive prompt only; -T for a pipe, a file or f1-status.
tty=(-T)
if [[ -t 0 && -t 1 ]]; then tty=(); fi
f1_compose "$F1_STATE/current.env" exec "${tty[@]}" -e PGOPTIONS='-c default_transaction_read_only=on' \
  db psql -X -U postgres -d f1 "$@"
