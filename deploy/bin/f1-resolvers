#!/usr/bin/env bash
# f1-resolvers (f1-firewall.service ExecStartPost, and every f1-tick; A§14.3, D7).
# Loads the host's IPv4 DNS resolvers into the set `inet f1 resolvers4`, the only DNS servers the
# f1 egress networks may reach. Docker's embedded DNS forwards a container's queries from the
# container's own namespace to the host's resolvers (with the systemd-resolved stub, to its
# upstream servers), so those are the ones allowed.
#
# Usage: f1-resolvers [--quiet]
#   --quiet  log only a missing resolver (f1-tick, every 10 minutes)
set -euo pipefail
# shellcheck source=deploy/bin/f1-lib.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/f1-lib.sh"

quiet=0
case "$#:${1:-}" in
  0:) ;;
  1:--quiet) quiet=1 ;;
  *)
    echo "usage: f1-resolvers [--quiet]" >&2
    exit 64
    ;;
esac

# The nameserver lines of a resolv.conf, without zone ids.
servers() { awk '$1 == "nameserver" { sub(/%.*/, "", $2); print $2 }' "$1" 2>/dev/null || true; }

conf=/etc/resolv.conf
if ! servers "$conf" | grep -qvE '^(127\.|::1$)' && [[ -r /run/systemd/resolve/resolv.conf ]]; then
  conf=/run/systemd/resolve/resolv.conf
fi
v4=()
while IFS= read -r addr; do
  if [[ $addr =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ && $addr != 127.* ]]; then
    v4+=("$addr")
  fi
done < <(servers "$conf" | sort -u)

batch='flush set inet f1 resolvers4'$'\n'
if ((${#v4[@]})); then
  batch+="add element inet f1 resolvers4 { $(IFS=,; echo "${v4[*]}") }"$'\n'
fi
printf '%s' "$batch" | nft -f -
((quiet)) || log "f1 container DNS allowed to ${#v4[@]} IPv4 resolver(s) from $conf"
if ((${#v4[@]} == 0)); then
  log "warning: no IPv4 resolver in $conf: f1 containers have no DNS until the next f1-tick"
fi
