{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/secrets/**)",
      "Read(**/*.secret)",
      "Read(//etc/f1/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git * push -f*)",
      "Bash(git * push * -f*)",
      "Bash(git * push --force*)",
      "Bash(git * push * --force*)",
      "Bash(git * push +*)",
      "Bash(git * push * +*)",
      "Bash(git * push *--mirror*)",
      "Bash(git * push *--delete*)",
      "Bash(git send-pack*)",
      "Bash(git * send-pack*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push * *:refs/heads/main*)",
      "Bash(gh pr merge*)",
      "Bash(gh * pr merge*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *git/refs*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret*)",
      "Bash(pnpm dlx*)",
      "Bash(pnpm exec*)",
      "Bash(pnpm * dlx*)",
      "Bash(pnpm * exec*)",
      "Bash(pnpx*)",
      "Bash(npx*)"
    ],
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm test:integration)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)"
    ]
  }
}
