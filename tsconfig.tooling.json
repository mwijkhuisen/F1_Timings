{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.cache/tsc/tooling.tsbuildinfo"
  },
  "include": [
    "vitest.config.ts",
    "scripts/*.ts",
    "test/**/*.ts",
    "apps/*/scripts/*.ts",
    "apps/*/test/**/*.ts",
    "packages/*/test/**/*.ts"
  ],
  // The web tests have their own project (browser libs, JSX).
  "exclude": ["apps/web/test"],
  "references": [{ "path": "packages/contracts" }, { "path": "apps/server" }]
}
